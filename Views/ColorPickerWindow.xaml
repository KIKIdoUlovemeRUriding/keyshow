<Window x:Class="KeyShow.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择颜色"
        Width="420" Height="580"
        MinHeight="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- SV 平面 (Saturation × Brightness) -->
            <Grid Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Grid Width="280" Height="180" ClipToBounds="True"
                  MouseLeftButtonDown="SvCanvas_MouseDown"
                  MouseMove="SvCanvas_MouseMove"
                  MouseLeftButtonUp="SvCanvas_MouseUp"
                  Cursor="Cross">
                <!-- 当前色相纯色填充 -->
                <Rectangle x:Name="HueFill"/>
                <!-- 水平：白→透明 (Saturation) -->
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="White" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- 垂直：透明→黑 (Brightness) -->
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="Black" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- 十字准星 -->
                <Canvas x:Name="SvCrosshairCanvas" IsHitTestVisible="False">
                    <Ellipse x:Name="SvCrosshair" Width="12" Height="12"
                             Stroke="White" StrokeThickness="2.5"
                             Fill="Transparent" Canvas.Left="0" Canvas.Top="0"/>
                </Canvas>
            </Grid>
        </Grid>

        <!-- 色相滑条 + 透明度滑条 -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 色相条 -->
            <Border Grid.Column="0" Width="24" Height="180" CornerRadius="3"
                    MouseLeftButtonDown="HueBar_MouseDown"
                    MouseMove="HueBar_MouseMove"
                    MouseLeftButtonUp="HueBar_MouseUp"
                    Cursor="Cross" Margin="0,0,10,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Red" Offset="0.00"/>
                        <GradientStop Color="Yellow" Offset="0.17"/>
                        <GradientStop Color="Lime" Offset="0.33"/>
                        <GradientStop Color="Cyan" Offset="0.50"/>
                        <GradientStop Color="Blue" Offset="0.67"/>
                        <GradientStop Color="Magenta" Offset="0.83"/>
                        <GradientStop Color="Red" Offset="1.00"/>
                    </LinearGradientBrush>
                </Border.Background>
                <!-- 色相指示器 -->
                <Canvas x:Name="HueIndicatorCanvas" IsHitTestVisible="False">
                    <Border x:Name="HueIndicator" Width="26" Height="4"
                            BorderBrush="White" BorderThickness="1"
                            Background="Transparent"
                            Canvas.Left="-1" Canvas.Top="0"/>
                </Canvas>
            </Border>

            <!-- 透明度条 -->
            <Border Grid.Column="1" Width="24" Height="180" CornerRadius="3"
                    MouseLeftButtonDown="AlphaBar_MouseDown"
                    MouseMove="AlphaBar_MouseMove"
                    MouseLeftButtonUp="AlphaBar_MouseUp"
                    Cursor="Cross">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="White" Offset="0"/>
                        <GradientStop Color="Black" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Canvas x:Name="AlphaIndicatorCanvas" IsHitTestVisible="False">
                    <Border x:Name="AlphaIndicator" Width="26" Height="4"
                            BorderBrush="White" BorderThickness="1"
                            Background="Transparent"
                            Canvas.Left="-1" Canvas.Top="0"/>
                </Canvas>
            </Border>

            <!-- 预览区 -->
            <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="CurrentLabel" Text="当前" FontSize="12" Margin="0,0,0,4"/>
                <Border x:Name="ColorPreview" Width="64" Height="64"
                        CornerRadius="6" BorderBrush="#555" BorderThickness="1"/>
                <TextBlock x:Name="HexLabel" FontSize="13" FontFamily="Consolas"
                           FontWeight="SemiBold" Margin="0,8,0,0" TextAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 常用色板 -->
        <TextBlock x:Name="CommonLabel" Grid.Row="2" Text="常用颜色" FontSize="12" Margin="0,0,0,6"/>
        <WrapPanel x:Name="PalettePanel" Grid.Row="3" Margin="0,0,0,14"/>

        <!-- 按钮 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelBtn" Content="取消" Width="80" Height="32" Margin="0,0,10,0"
                    Click="Cancel_Click" IsCancel="True"/>
            <Button x:Name="OkBtn" Content="确定" Width="80" Height="32"
                    Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
