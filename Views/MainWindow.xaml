<Window x:Class="KeyShow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KeyShow"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Title="KeyShow"
       
        Width="400" Height="100">

    <Window.Resources>
        <local:StringToBrushConverter x:Key="ColorConverter"/>
        <local:CardPaddingConverter x:Key="PaddingConverter"/>
        <local:FontFamilyConverter x:Key="FontConverter"/>
        <local:BoolToFontWeightConverter x:Key="BoldConverter"/>
    </Window.Resources>

    <ItemsControl x:Name="KeyList" Margin="10"
                  MouseLeftButtonDown="KeyList_MouseLeftButtonDown"
                  MouseEnter="KeyList_MouseEnter"
                  MouseLeave="KeyList_MouseLeave"
                  Cursor="SizeAll">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <!-- Grid 叠加：流光矩形 + 按键卡片 -->
                <Grid Margin="3">
                    <!-- 流光层：Rectangle 描边，StrokeDashOffset 动画实现一笔画 -->
                    <Rectangle x:Name="GlowRect" RadiusX="7" RadiusY="7"
                               Stroke="Transparent" StrokeThickness="2.5"
                               StrokeDashArray="30,500" StrokeDashCap="Round"
                               Fill="Transparent" IsHitTestVisible="False"/>
                    <!-- 按键卡片 -->
                    <Border CornerRadius="6" Padding="12,6"
                            MinWidth="{Binding Source={x:Static local:AppSettings.Instance}, Path=CardMinWidth}"
                            RenderTransformOrigin="0.5,0.5"
                            Opacity="{Binding Opacity}"
                            Background="{Binding Source={x:Static local:AppSettings.Instance}, Path=BackgroundColor, Converter={StaticResource ColorConverter}}">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                                                         From="0" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="1.2"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                                                         From="0" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="1.2"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <TextBlock Text="{Binding Text}"
                                   FontSize="{Binding Source={x:Static local:AppSettings.Instance}, Path=FontSize}"
                                   FontWeight="{Binding Source={x:Static local:AppSettings.Instance}, Path=FontBold, Converter={StaticResource BoldConverter}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{Binding Source={x:Static local:AppSettings.Instance}, Path=FontColor, Converter={StaticResource ColorConverter}}"
                                   FontFamily="{Binding Source={x:Static local:AppSettings.Instance}, Path=FontFamilyName, Converter={StaticResource FontConverter}}"/>
                    </Border>
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Window>
