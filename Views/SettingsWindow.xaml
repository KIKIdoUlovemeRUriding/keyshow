<Window x:Class="KeyShow.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyShow Settings"
       
        Width="400" Height="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><!-- 0:MaxKeys -->
                <RowDefinition Height="Auto"/><!-- 1:CardHeight -->
                <RowDefinition Height="Auto"/><!-- 2:CardMinWidth -->
                <RowDefinition Height="Auto"/><!-- 3:Visible -->
                <RowDefinition Height="Auto"/><!-- 4:Fade -->
                <RowDefinition Height="Auto"/><!-- 5:BgColor -->
                <RowDefinition Height="Auto"/><!-- 6:FontColor -->
                <RowDefinition Height="Auto"/><!-- 7:Font -->
                <RowDefinition Height="Auto"/><!-- 8:Position -->
                <RowDefinition Height="Auto"/><!-- 9:Language -->
                <RowDefinition Height="Auto"/><!-- 10:AutoStart -->
                <RowDefinition Height="Auto"/><!-- 11:Buttons -->
            </Grid.RowDefinitions>

            <!-- 最大按键数 -->
            <GroupBox x:Name="MaxKeysHeader" Grid.Row="0" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="MaxKeysSlider" Minimum="3" Maximum="10"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            ValueChanged="MaxKeysSlider_ValueChanged"/>
                    <TextBlock x:Name="MaxKeysLabel" Grid.Column="1" Width="24"
                               TextAlignment="Center" FontSize="16" FontWeight="Bold"/>
                </Grid>
            </GroupBox>

            <!-- 卡片高度 -->
            <GroupBox x:Name="CardHeightHeader" Grid.Row="1" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="CardPaddingSlider" Minimum="2" Maximum="18"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            ValueChanged="CardPaddingSlider_ValueChanged"/>
                    <TextBlock x:Name="CardPaddingLabel" Grid.Column="1" Width="24"
                               TextAlignment="Center" FontSize="16" FontWeight="Bold"/>
                </Grid>
            </GroupBox>

            <!-- 卡片最小宽度 -->
            <GroupBox x:Name="CardMinWidthHeader" Grid.Row="2" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="CardMinWidthSlider" Minimum="20" Maximum="80"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            ValueChanged="CardMinWidthSlider_ValueChanged"/>
                    <TextBlock x:Name="CardMinWidthLabel" Grid.Column="1" Width="30"
                               TextAlignment="Center" FontSize="16" FontWeight="Bold"/>
                </Grid>
            </GroupBox>

            <!-- 显示时长 -->
            <GroupBox x:Name="VisibleHeader" Grid.Row="3" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="VisibleSlider" Minimum="0.5" Maximum="4"
                            IsSnapToTickEnabled="True" TickFrequency="0.5"
                            ValueChanged="VisibleSlider_ValueChanged"/>
                    <TextBlock x:Name="VisibleLabel" Grid.Column="1" Width="30"
                               TextAlignment="Center" FontSize="16" FontWeight="Bold"/>
                </Grid>
            </GroupBox>

            <!-- 淡出时长 -->
            <GroupBox x:Name="FadeHeader" Grid.Row="4" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="FadeSlider" Minimum="0.3" Maximum="2"
                            IsSnapToTickEnabled="True" TickFrequency="0.1"
                            ValueChanged="FadeSlider_ValueChanged"/>
                    <TextBlock x:Name="FadeLabel" Grid.Column="1" Width="30"
                               TextAlignment="Center" FontSize="16" FontWeight="Bold"/>
                </Grid>
            </GroupBox>

            <!-- 背景颜色 -->
            <GroupBox x:Name="BgColorHeader" Grid.Row="5" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BgColorBtn" Click="BgColorBtn_Click"
                            HorizontalAlignment="Left" Padding="12,6" FontSize="13"/>
                    <Border x:Name="BgColorPreview" Grid.Column="1" Width="32" Height="32"
                            CornerRadius="5" BorderBrush="#555" BorderThickness="1"/>
                </Grid>
            </GroupBox>

            <!-- 字体颜色 -->
            <GroupBox x:Name="FontColorHeader" Grid.Row="6" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="FontColorBtn" Click="FontColorBtn_Click"
                            HorizontalAlignment="Left" Padding="12,6" FontSize="13"/>
                    <Border x:Name="FontColorPreview" Grid.Column="1" Width="32" Height="32"
                            CornerRadius="5" BorderBrush="#555" BorderThickness="1"/>
                </Grid>
            </GroupBox>

            <!-- 字体选择 -->
            <GroupBox x:Name="FontHeader" Grid.Row="7" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <ComboBox x:Name="FontCombo" Margin="0,0,0,6"
                              SelectionChanged="FontCombo_SelectionChanged"/>
                    <TextBlock x:Name="CustomFontLabel" FontSize="11"
                               Foreground="#888" TextWrapping="Wrap"/>
                    <Button x:Name="ImportFontBtn" HorizontalAlignment="Left"
                            Padding="10,4" Click="ImportFont_Click" Margin="0,0,0,6"/>
                    <CheckBox x:Name="FontBoldCheck" FontSize="13"
                              Checked="FontBold_Changed" Unchecked="FontBold_Changed"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FontSizeLabel" VerticalAlignment="Center"
                                   FontSize="12" Margin="0,0,6,0"/>
                        <Slider x:Name="FontSizeSlider" Grid.Column="1" Minimum="10" Maximum="40"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                ValueChanged="FontSizeSlider_ValueChanged"/>
                        <TextBlock x:Name="FontSizeValue" Grid.Column="2" Width="30"
                                   TextAlignment="Center" FontSize="14" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- 显示位置 -->
            <GroupBox x:Name="PositionHeader" Grid.Row="8" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <RadioButton x:Name="PosBottomRight"
                                 Checked="Position_Changed" Margin="0,3"/>
                    <RadioButton x:Name="PosBottomLeft"
                                 Checked="Position_Changed" Margin="0,3"/>
                    <RadioButton x:Name="PosBottomCenter"
                                 Checked="Position_Changed" Margin="0,3"/>
                    <TextBlock x:Name="PosDragTip" FontSize="11"
                               Foreground="#888" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <!-- 语言 -->
            <GroupBox x:Name="LanguageHeader" Grid.Row="9" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <RadioButton x:Name="LangZhRadio"
                                 Checked="Language_Changed" Margin="0,3"/>
                    <RadioButton x:Name="LangEnRadio"
                                 Checked="Language_Changed" Margin="0,3"/>
                </StackPanel>
            </GroupBox>

            <!-- 开机自启 -->
            <CheckBox x:Name="AutoStartCheck"
                      Grid.Row="10" Margin="0,0,0,10" FontSize="14"/>

            <!-- 按钮 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        Grid.Row="11" Margin="0,4,0,0">
                <Button x:Name="CancelBtn" Width="80" Height="32" Margin="0,0,10,0"
                        Click="Cancel_Click"/>
                <Button x:Name="SaveBtn" Width="80" Height="32"
                        Click="Save_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
